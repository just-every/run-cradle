{
  "version": 1,
  "project": "just-every/cradle",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "originVar": "APP_ORIGIN",
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "r2": [
    {
      "binding": "FILES"
    }
  ],
  "queues": [
    {
      "binding": "WORK_QUEUE",
      "consumer": {
        "batch_size": 10,
        "max_retries": 3
      }
    }
  ],
  "durableObjects": [
    {
      "binding": "INSTALLATION",
      "className": "InstallationCoordinator",
      "storage": "sqlite"
    }
  ],
  "secrets": [
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM"
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER"
    },
    {
      "binding": "MAIL_PROVIDER_API_KEY",
      "environment": "MAIL_PROVIDER_API_KEY"
    },
    {
      "binding": "CONNECTION_ENCRYPTION_KEY",
      "environment": "CONNECTION_ENCRYPTION_KEY"
    }
  ],
  "crons": [
    "* * * * *"
  ],
  "vars": {}
}
