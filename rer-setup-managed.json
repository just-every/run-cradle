{
  "schema": 1,
  "title": "Cradle",
  "groups": [
    {
      "id": "owner",
      "label": "Your workspace"
    },
    {
      "id": "hosting-mail",
      "label": "Email delivery",
      "help": "Managed mail needs no provider account. For your own hosting, choose a provider and verified sender."
    },
    {
      "id": "egress",
      "label": "Optional outbound automation delivery",
      "help": "Use your trusted HTTPS relay for webhook and Slack actions."
    },
    {
      "id": "service-connections",
      "label": "Optional service connections",
      "help": "Leave these blank unless you use the corresponding Google, Xero, AI or candidate service. Connect and approve each service separately in your workspace."
    }
  ],
  "fields": [
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "Use your Run Edit Run account email to claim this workspace and sign in.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "OWNER_NAME",
      "label": "Your name",
      "kind": "text",
      "required": true,
      "default": "Owner",
      "group": "owner"
    },
    {
      "name": "WORKSPACE_NAME",
      "label": "Workspace name",
      "kind": "text",
      "required": true,
      "default": "Cradle records",
      "group": "owner"
    },
    {
      "name": "WORKSPACE_TIMEZONE",
      "label": "Timezone",
      "kind": "timezone",
      "required": true,
      "default": "UTC",
      "group": "owner"
    },
    {
      "name": "WORKSPACE_CURRENCY",
      "label": "Currency",
      "kind": "text",
      "required": true,
      "default": "USD",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner",
      "help": "Generated privately for this installation to protect operator sessions. Keep it with the installation secrets."
    },
    {
      "name": "INSTALLATION_KEY",
      "label": "Installation key",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner",
      "help": "Generated privately for this installation to seal dependency signing keys. Keep it with the installation secrets and retain its rotation history."
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "owner",
      "help": "Generated privately for this installation to authorize first-owner setup. Keep it with the installation secrets."
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Email delivery",
      "kind": "select",
      "required": true,
      "default": "resend",
      "options": [
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "resend",
          "label": "Resend"
        }
      ],
      "group": "hosting-mail"
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender email",
      "kind": "email",
      "required": false,
      "group": "hosting-mail",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "hosting-mail"
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Managed mail credential",
      "kind": "secret",
      "required": true,
      "ownerVisible": true,
      "input": "entered",
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "hosting-mail",
      "help": "Use the managed mail credential supplied for this installation by Run Edit Run."
    },
    {
      "name": "MAIL_PROVIDER_API_KEY",
      "label": "Email provider API key for hosting",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "hosting-mail",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        }
      ],
      "help": "Use an API key from the selected SendGrid or Resend account with permission to send from your verified sender."
    },
    {
      "name": "CONNECTION_ENCRYPTION_KEY",
      "label": "Connection encryption key",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "base64",
      "group": "owner",
      "help": "Generated privately to encrypt saved connection credentials. Preserve it with backups so those credentials remain readable."
    },
    {
      "name": "EGRESS_RELAY_URL",
      "label": "Trusted HTTPS relay URL",
      "kind": "url",
      "required": false,
      "group": "egress"
    },
    {
      "name": "EGRESS_RELAY_SECRET",
      "label": "Relay credential",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "egress"
    },
    {
      "name": "AI_PROVIDER_API_KEY",
      "label": "AI service API key",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "GOOGLE_CLIENT_ID",
      "label": "Google OAuth client ID",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "GOOGLE_CLIENT_SECRET",
      "label": "Google OAuth client secret",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "XERO_CLIENT_ID",
      "label": "Xero OAuth client ID",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "XERO_CLIENT_SECRET",
      "label": "Xero OAuth client secret",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "MICROSOFT_CLIENT_ID",
      "label": "Microsoft OAuth client ID",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "MICROSOFT_CLIENT_SECRET",
      "label": "Microsoft OAuth client secret",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "DROPBOX_CLIENT_ID",
      "label": "Dropbox OAuth client ID",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "DROPBOX_CLIENT_SECRET",
      "label": "Dropbox OAuth client secret",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "BOX_CLIENT_ID",
      "label": "Box OAuth client ID",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "BOX_CLIENT_SECRET",
      "label": "Box OAuth client secret",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "CANDIDATE_RUNNER_TOKEN",
      "label": "Candidate runner credential",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "CANDIDATE_DEPLOY_TOKEN",
      "label": "Candidate delivery credential",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "service-connections"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth installation. Leave blank for email links. Linking requires approval from both installation owners; existing workspaces enable provider sign-in in identity settings.",
      "group": "service-connections"
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
