{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cradle",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cradle",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/core"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "cradle-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WORK_QUEUE",
        "queue": "cradle-work"
      }
    ],
    "consumers": [
      {
        "queue": "cradle-work",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INSTALLATION",
        "class_name": "InstallationCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-installation",
      "new_sqlite_classes": [
        "InstallationCoordinator"
      ]
    }
  ]
}
