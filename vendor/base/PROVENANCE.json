  "adoption": "Base production exports are byte-exact at their component origins. Portable onboarding QA lives under tests/onboarding. Cradle proves its integration through real local credentials, HTTP, migrations and browser journeys.",
  "adaptations": [
    {
      "paths": [
        "scripts/installer/local.mjs",
        "scripts/installer/owner.mjs",
        "scripts/deployment/owner-artifact.mjs"
      ],
      "description": "Thin Cradle hooks declare the emitted Worker, all migration groups, actual owner bootstrap and full migration artifact. The shared Base installer owns private settings, subprocess custody, redaction and local sign-in. Onboarding test-manifest-support is excluded as a test helper."
    },
    {
      "paths": [
        "tests/onboarding/fixtures/build-process.mjs"
      ],
      "description": "The portable custody fixture publishes its complete PID handoff atomically. Its assertions still observe and stop real child processes."
    }
  ],
