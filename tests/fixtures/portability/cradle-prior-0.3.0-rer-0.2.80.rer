ody_states","type":"trigger"},{"name":"ik_d1_custody_state_receipt","sql":"CREATE TRIGGER ik_d1_custody_state_receipt AFTER UPDATE ON ik_d1_custody_states BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_stream_delete","sql":"CREATE TRIGGER ik_d1_custody_state_stream_delete BEFORE DELETE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_custody_state_stream_update","sql":"CREATE TRIGGER ik_d1_custody_state_stream_update BEFORE UPDATE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_erasure_journal_delete","sql":"CREATE TRIGGER ik_d1_erasure_journal_delete BEFORE DELETE ON ik_d1_erasure_journal BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_erasure_journal_insert","sql":"CREATE TRIGGER ik_d1_erasure_journal_insert BEFORE INSERT ON ik_d1_erasure_journal WHEN EXISTS(SELECT 1 FROM ik_d1_erasure_journal WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_erasure_journal_time","sql":"CREATE INDEX ik_d1_erasure_journal_time ON ik_d1_erasure_journal(destination, recorded_at)","table":"ik_d1_erasure_journal","type":"index"},{"name":"ik_d1_erasure_journal_update","sql":"CREATE TRIGGER ik_d1_erasure_journal_update BEFORE UPDATE ON ik_d1_erasure_journal BEGIN SELECT RAISE(ABORT,'IMPORT_ERASURE_JOURNAL_APPEND_ONLY'); END","table":"ik_d1_erasure_journal","type":"trigger"},{"name":"ik_d1_history_job","sql":"CREATE INDEX ik_d1_history_job ON ik_d1_history(job_id)","table":"ik_d1_history","type":"index"},{"name":"ik_d1_history_source","sql":"CREATE INDEX ik_d1_history_source ON ik_d1_history(source_identity)","table":"ik_d1_history","type":"index"},{"name":"ik_d1_plan_index_delete","sql":"CREATE TRIGGER ik_d1_plan_index_delete AFTER DELETE ON ik_d1_plan_index BEGIN DELETE FROM ik_d1_indexed_jobs WHERE job_id=OLD.job_id; END","table":"ik_d1_plan_index","type":"trigger"},{"name":"ik_d1_plan_index_insert","sql":"CREATE TRIGGER ik_d1_plan_index_insert AFTER INSERT ON ik_d1_plan_index BEGIN DELETE FROM ik_d1_indexed_jobs WHERE job_id=NEW.job_id; END","table":"ik_d1_plan_index","type":"trigger"},{"name":"ik_d1_plan_index_source","sql":"CREATE INDEX ik_d1_plan_index_source ON ik_d1_plan_index(source_identity,job_id)","table":"ik_d1_plan_index","type":"index"},{"name":"ik_d1_plan_index_target","sql":"CREATE INDEX ik_d1_plan_index_target ON ik_d1_plan_index(target_identity,job_id)","table":"ik_d1_plan_index","type":"index"},{"name":"ik_d1_plan_index_update","sql":"CREATE TRIGGER ik_d1_plan_index_update AFTER UPDATE ON ik_d1_plan_index BEGIN DELETE FROM ik_d1_indexed_jobs WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_plan_index","type":"trigger"},{"name":"ik_d1_preparation_steps_binding","sql":"CREATE TRIGGER ik_d1_preparation_steps_binding BEFORE UPDATE OF id,destination,namespace,mapping_version,principal_id,operation_key,reversal_policy,codec_id,source_digest,total ON ik_d1_preparation_steps BEGIN SELECT RAISE(ABORT,'IMPORT_PREPARATION_BINDING_CHANGED'); END","table":"ik_d1_preparation_steps","type":"trigger"},{"name":"ik_d1_preparation_steps_revision","sql":"CREATE TRIGGER ik_d1_preparation_steps_revision BEFORE UPDATE ON ik_d1_preparation_steps WHEN NEW.revision<>OLD.revision+1 BEGIN SELECT RAISE(ABORT,'IMPORT_PREPARATION_CHANGED'); END","table":"ik_d1_preparation_steps","type":"trigger"},{"name":"ik_d1_publication_child_page_delete","sql":"CREATE TRIGGER ik_d1_publication_child_page_delete BEFORE DELETE ON ik