N UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='attempts'; END","table":"execution_attempts","type":"trigger"},{"name":"execution_attempts_run","sql":"CREATE INDEX execution_attempts_run ON execution_attempts(run_id,id)","table":"execution_attempts","type":"index"},{"name":"execution_attempts_update","sql":"CREATE TRIGGER execution_attempts_update AFTER UPDATE ON execution_attempts BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='attempts'; END","table":"execution_attempts","type":"trigger"},{"name":"execution_calls_delete","sql":"CREATE TRIGGER execution_calls_delete AFTER DELETE ON execution_model_calls BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='calls'; END","table":"execution_model_calls","type":"trigger"},{"name":"execution_calls_insert","sql":"CREATE TRIGGER execution_calls_insert AFTER INSERT ON execution_model_calls BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='calls'; END","table":"execution_model_calls","type":"trigger"},{"name":"execution_calls_update","sql":"CREATE TRIGGER execution_calls_update AFTER UPDATE ON execution_model_calls BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='calls'; END","table":"execution_model_calls","type":"trigger"},{"name":"execution_connections_delete","sql":"CREATE TRIGGER execution_connections_delete AFTER DELETE ON provider_connections BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='connections'; END","table":"provider_connections","type":"trigger"},{"name":"execution_connections_insert","sql":"CREATE TRIGGER execution_connections_insert AFTER INSERT ON provider_connections BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='connections'; END","table":"provider_connections","type":"trigger"},{"name":"execution_connections_update","sql":"CREATE TRIGGER execution_connections_update AFTER UPDATE ON provider_connections BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='connections'; END","table":"provider_connections","type":"trigger"},{"name":"execution_one_human_resolution","sql":"CREATE UNIQUE INDEX execution_one_human_resolution ON execution_receipts(attempt_id) WHERE method='human_evidence'","table":"execution_receipts","type":"index"},{"name":"execution_profiles_delete","sql":"CREATE TRIGGER execution_profiles_delete AFTER DELETE ON execution_model_profiles BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='profiles'; END","table":"execution_model_profiles","type":"trigger"},{"name":"execution_profiles_insert","sql":"CREATE TRIGGER execution_profiles_insert AFTER INSERT ON execution_model_profiles BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='profiles'; END","table":"execution_model_profiles","type":"trigger"},{"name":"execution_profiles_update","sql":"CREATE TRIGGER execution_profiles_update AFTER UPDATE ON execution_model_profiles BEGIN UPDATE execution_collection_revisions SET revision=revision+1 WHERE name='profiles'; END","table":"execution_model_profiles","type":"trigger"},{"name":"execution_runs_due","sql":"CREATE INDEX execution_runs_due ON execution_runs(state,next_wake_at,id)","table":"execution_runs","type":"index"},{"name":"ik_active_target","sql":"CREATE UNIQUE INDEX ik_active_target ON ik_provenance(destination,target_kind,target_id) WHERE reversed=0","table":"ik_provenance","type":"index"},{"name":"ik_d1_creation_plan_capture","sql":"CREATE TRIGGER ik_d1_creation_plan_capture AFTER INSERT ON ik_d1_plan_chunks BEGIN INSERT INTO ik_d1_creation_plans(job_id,ordinal,body) VALUES(NEW.job_id,NEW.ordinal,NEW.body); END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_creation_plan_immutable","sql":"CREATE TRIGGER ik_d1_creation_plan_immutable BEFORE UPDATE ON ik_d1_creation_plans WHEN NEW.job_id IS NOT OLD.job_id OR NEW.ordinal IS NOT OLD.ordinal OR NEW.body IS NOT OLD.body OR OLD.released<>0 OR NEW.released<>1 OR NOT EXISTS(SELECT 1 FROM ik_d1_plan_chunks p WHERE p.job_id=OLD.job_id AND p.ordinal=OLD.ordinal AND p.body IS OLD.body) BEGIN SELECT RAISE(ABORT,'IMPORT_CREATION_SNAPSHOT_CHANGED'); END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_creation_plan_release","sql":"CREATE TRIGGER ik_d1_creation_plan_release BEFORE DELETE ON ik_d1_creation_plans WHEN OLD.released<>1 BEGIN SELECT RAISE(ABORT,'IMPORT_CREATION_SNAPSHOT_CHANGED'); END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_chunks_delete","sql":"CREATE TRIGGER ik_d1_custody_chunks_delete AFTER DELETE ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_chunks_insert","sql":"CREATE TRIGGER ik_d1_custody_chunks_insert AFTER INSERT ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_chunks_update","sql":"CREATE TRIGGER ik_d1_custody_chunks_update AFTER UPDATE ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_job_insert","sql":"CREATE TRIGGER ik_d1_custody_job_insert AFTER INSERT ON ik_jobs BEGIN INSERT INTO ik_d1_custody_revisions(job_id) VALUES(NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_job_update","sql":"CREATE TRIGGER ik_d1_custody_job_update AFTER UPDATE OF plan_json ON ik_jobs BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.id OR job_id=NEW.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_receipt_insert","sql":"CREATE TRIGGER ik_d1_custody_receipt_insert BEFORE INSERT ON ik_d1_custody_revisions WHEN NEW.seal IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ik_d1_publication_fences WHERE job_id=NEW.job_id AND stream_id=NEW.seal) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_RECEIPT_CHANGED'); END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_receipt_revision","sql":"CREATE TRIGGER ik_d1_custody_receipt_revision AFTER UPDATE OF revision ON ik_d1_custody_revisions BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_receipt_seal","sql":"CREATE TRIGGER ik_d1_custody_receipt_seal BEFORE UPDATE OF seal ON ik_d1_custody_revisions WHEN NEW.seal IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ik_d1_publication_fences WHERE job_id=NEW.job_id AND stream_id=NEW.seal) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_RECEIPT_CHANGED'); END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_state_create","sql":"CREATE TRIGGER ik_d1_custody_state_create AFTER INSERT ON ik_jobs BEGIN INSERT INTO ik_d1_custody_states(job_id) VALUES(NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_state_delete","sql":"CREATE TRIGGER ik_d1_custody_state_delete BEFORE DELETE ON ik_d1_custody_states WHEN EXISTS(SELECT 1 FROM ik_jobs WHERE id=OLD.job_id) BEGIN SELECT RAISE(ABORT,'IMPORT_CUSTODY_STATE_CHANGED'); END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_delete AFTER DELETE ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_insert AFTER INSERT ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_bat