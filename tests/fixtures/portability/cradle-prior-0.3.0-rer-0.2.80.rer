_d1_creation_plan_immutable BEFORE UPDATE ON ik_d1_creation_plans WHEN NEW.job_id IS NOT OLD.job_id OR NEW.ordinal IS NOT OLD.ordinal OR NEW.body IS NOT OLD.body OR OLD.released<>0 OR NEW.released<>1 OR NOT EXISTS(SELECT 1 FROM ik_d1_plan_chunks p WHERE p.job_id=OLD.job_id AND p.ordinal=OLD.ordinal AND p.body IS OLD.body) BEGIN SELECT RAISE(ABORT,'IMPORT_CREATION_SNAPSHOT_CHANGED'); END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_creation_plan_release","sql":"CREATE TRIGGER ik_d1_creation_plan_release BEFORE DELETE ON ik_d1_creation_plans WHEN OLD.released<>1 BEGIN SELECT RAISE(ABORT,'IMPORT_CREATION_SNAPSHOT_CHANGED'); END","table":"ik_d1_creation_plans","type":"trigger"},{"name":"ik_d1_custody_chunks_delete","sql":"CREATE TRIGGER ik_d1_custody_chunks_delete AFTER DELETE ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_chunks_insert","sql":"CREATE TRIGGER ik_d1_custody_chunks_insert AFTER INSERT ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_chunks_update","sql":"CREATE TRIGGER ik_d1_custody_chunks_update AFTER UPDATE ON ik_d1_plan_chunks BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_plan_chunks","type":"trigger"},{"name":"ik_d1_custody_job_insert","sql":"CREATE TRIGGER ik_d1_custody_job_insert AFTER INSERT ON ik_jobs BEGIN INSERT INTO ik_d1_custody_revisions(job_id) VALUES(NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_job_update","sql":"CREATE TRIGGER ik_d1_custody_job_update AFTER UPDATE OF plan_json ON ik_jobs BEGIN UPDATE ik_d1_custody_revisions SET revision=revision+1 WHERE job_id=OLD.id OR job_id=NEW.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_receipt_insert","sql":"CREATE TRIGGER ik_d1_custody_receipt_insert BEFORE INSERT ON ik_d1_custody_revisions WHEN NEW.seal IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ik_d1_publication_fences WHERE job_id=NEW.job_id AND stream_id=NEW.seal) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_RECEIPT_CHANGED'); END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_receipt_revision","sql":"CREATE TRIGGER ik_d1_custody_receipt_revision AFTER UPDATE OF revision ON ik_d1_custody_revisions BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_receipt_seal","sql":"CREATE TRIGGER ik_d1_custody_receipt_seal BEFORE UPDATE OF seal ON ik_d1_custody_revisions WHEN NEW.seal IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ik_d1_publication_fences WHERE job_id=NEW.job_id AND stream_id=NEW.seal) BEGIN SELECT RAISE(ABORT,'IMPORT_PUBLICATION_RECEIPT_CHANGED'); END","table":"ik_d1_custody_revisions","type":"trigger"},{"name":"ik_d1_custody_state_create","sql":"CREATE TRIGGER ik_d1_custody_state_create AFTER INSERT ON ik_jobs BEGIN INSERT INTO ik_d1_custody_states(job_id) VALUES(NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_custody_state_delete","sql":"CREATE TRIGGER ik_d1_custody_state_delete BEFORE DELETE ON ik_d1_custody_states WHEN EXISTS(SELECT 1 FROM ik_jobs WHERE id=OLD.job_id) BEGIN SELECT RAISE(ABORT,'IMPORT_CUSTODY_STATE_CHANGED'); END","table":"ik_d1_custody_states","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_delete AFTER DELETE ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_batches","type":"trigger"},{"name":"ik_d1_custody_state_ik_batches_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_batches_insert AFTER INSERT ON ik_batches BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id;