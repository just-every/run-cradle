ources_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_delete AFTER DELETE ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.source_identity=OLD.identity AND j.destination=OLD.destination); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_sources_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_insert AFTER INSERT ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.source_identity=NEW.identity AND j.destination=NEW.destination); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_sources_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_sources_update AFTER UPDATE ON ik_d1_erased_sources BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE (i.source_identity=OLD.identity AND j.destination=OLD.destination) OR (i.source_identity=NEW.identity AND j.destination=NEW.destination)); END","table":"ik_d1_erased_sources","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_delete AFTER DELETE ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.target_identity=OLD.identity AND j.destination=OLD.destination); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_insert AFTER INSERT ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE i.target_identity=NEW.identity AND j.destination=NEW.destination); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_erased_targets_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_erased_targets_update AFTER UPDATE ON ik_d1_erased_targets BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id IN (SELECT i.job_id FROM ik_d1_plan_index i JOIN ik_jobs j ON j.id=i.job_id WHERE (i.target_identity=OLD.identity AND j.destination=OLD.destination) OR (i.target_identity=NEW.identity AND j.destination=NEW.destination)); END","table":"ik_d1_erased_targets","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_delete AFTER DELETE ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_insert AFTER INSERT ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=NEW.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_history_update","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_history_update AFTER UPDATE ON ik_d1_history BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_history","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_indexed_jobs_delete","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_indexed_jobs_delete AFTER DELETE ON ik_d1_indexed_jobs BEGIN UPDATE ik_d1_custody_states SET revision=revision+1 WHERE job_id=OLD.job_id; END","table":"ik_d1_indexed_jobs","type":"trigger"},{"name":"ik_d1_custody_state_ik_d1_indexed_jobs_insert","sql":"CREATE TRIGGER ik_d1_custody_state_ik_d1_indexed_jobs_insert AFTE