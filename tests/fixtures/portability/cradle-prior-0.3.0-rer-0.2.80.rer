":"trigger"},{"name":"ik_d1_receipt_ik_original_sets_insert","sql":"CREATE TRIGGER ik_d1_receipt_ik_original_sets_insert AFTER INSERT ON ik_original_sets BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_original_sets","type":"trigger"},{"name":"ik_d1_receipt_ik_original_sets_update","sql":"CREATE TRIGGER ik_d1_receipt_ik_original_sets_update AFTER UPDATE ON ik_original_sets BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_original_sets","type":"trigger"},{"name":"ik_d1_receipt_ik_originals_delete","sql":"CREATE TRIGGER ik_d1_receipt_ik_originals_delete AFTER DELETE ON ik_originals BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_receipt_ik_originals_insert","sql":"CREATE TRIGGER ik_d1_receipt_ik_originals_insert AFTER INSERT ON ik_originals BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_receipt_ik_originals_update","sql":"CREATE TRIGGER ik_d1_receipt_ik_originals_update AFTER UPDATE ON ik_originals BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_originals","type":"trigger"},{"name":"ik_d1_receipt_ik_provenance_delete","sql":"CREATE TRIGGER ik_d1_receipt_ik_provenance_delete AFTER DELETE ON ik_provenance BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id; END","table":"ik_provenance","type":"trigger"},{"name":"ik_d1_receipt_ik_provenance_insert","sql":"CREATE TRIGGER ik_d1_receipt_ik_provenance_insert AFTER INSERT ON ik_provenance BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_provenance","type":"trigger"},{"name":"ik_d1_receipt_ik_provenance_update","sql":"CREATE TRIGGER ik_d1_receipt_ik_provenance_update AFTER UPDATE ON ik_provenance BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_provenance","type":"trigger"},{"name":"ik_d1_receipt_ik_sources_delete","sql":"CREATE TRIGGER ik_d1_receipt_ik_sources_delete AFTER DELETE ON ik_sources BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id; END","table":"ik_sources","type":"trigger"},{"name":"ik_d1_receipt_ik_sources_insert","sql":"CREATE TRIGGER ik_d1_receipt_ik_sources_insert AFTER INSERT ON ik_sources BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_sources","type":"trigger"},{"name":"ik_d1_receipt_ik_sources_update","sql":"CREATE TRIGGER ik_d1_receipt_ik_sources_update AFTER UPDATE ON ik_sources BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_sources","type":"trigger"},{"name":"ik_d1_receipt_pages_delete","sql":"CREATE TRIGGER ik_d1_receipt_pages_delete AFTER DELETE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_receipt_pages_insert","sql":"CREATE TRIGGER ik_d1_receipt_pages_insert AFTER INSERT ON ik_d1_stream_pages BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_receipt_pages_update","sql":"CREATE TRIGGER ik_d1_receipt_pages_update AFTER UPDATE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id=OLD.job_id OR job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_receipt_stream_delete","sql":"CREATE TRIGGER ik_d1_receipt_stream_delete BEFORE DELETE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_receipt_stream_update","sql":"CREATE TRIGGER ik_d1_receipt_stream_update BEFORE UPDATE ON ik_d1_streams BEGIN UPDATE ik_d1_custody_revisions SET seal=NULL WHERE job_id IN (SELECT job_id FROM ik_d1_stream_pages WHERE stream_id=OLD.id); END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_retirement_delete","sql":"CREATE TRIGGER ik_d1_retirement_delete BEFORE DELETE ON ik_d1_retirements BEGIN SELECT RAISE(ABORT,'IMPORT_RETIREMENT_CHANGED'); END","table":"ik_d1_retirements","type":"trigger"},{"name":"ik_d1_retirement_insert","sql":"CREATE TRIGGER ik_d1_retirement_insert BEFORE INSERT ON ik_d1_retirements WHEN EXISTS(SELECT 1 FROM ik_d1_retirements WHERE id=NEW.id AND kind=NEW.kind) BEGIN SELECT RAISE(ABORT,'IMPORT_RETIREMENT_CHANGED'); END","table":"ik_d1_retirements","type":"trigger"},{"name":"ik_d1_retirement_update","sql":"CREATE TRIGGER ik_d1_retirement_update BEFORE UPDATE ON ik_d1_retirements BEGIN SELECT RAISE(ABORT,'IMPORT_RETIREMENT_CHANGED'); END","table":"ik_d1_retirements","type":"trigger"},{"name":"ik_d1_stream_origin_delete","sql":"CREATE TRIGGER ik_d1_stream_origin_delete BEFORE DELETE ON ik_d1_stream_origins WHEN EXISTS(SELECT 1 FROM ik_jobs WHERE id=OLD.job_id) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_origin_insert","sql":"CREATE TRIGGER ik_d1_stream_origin_insert BEFORE INSERT ON ik_d1_stream_origins WHEN EXISTS(SELECT 1 FROM ik_d1_stream_origins WHERE job_id=NEW.job_id) OR NOT EXISTS(SELECT 1 FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE ((((NEW.job_id IS p.job_id AND NEW.stream_id IS s.id) AND (NEW.ordinal IS p.ordinal AND NEW.page_total IS p.total)) AND ((NEW.job_operation_key IS j.operation_key AND NEW.parent_destination IS s.destination) AND (NEW.parent_namespace IS s.namespace AND (NEW.parent_mapping_version IS s.mapping_version AND NEW.parent_principal_id IS s.principal_id)))) AND (((NEW.parent_fingerprint IS s.fingerprint AND NEW.parent_operation_key IS s.operation_key) AND (NEW.parent_total IS s.total AND (NEW.parent_layout_hash IS s.layout_hash AND p.stream_id IS s.id))) AND ((j.total IS p.total AND j.destination IS s.destination) AND (j.namespace IS s.namespace AND (j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id)))))) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_origin_job_delete","sql":"CREATE TRIGGER ik_d1_stream_origin_job_delete AFTER DELETE ON ik_jobs BEGIN DELETE FROM ik_d1_stream_origins WHERE job_id=OLD.id; END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_origin_page_insert","sql":"CREATE TRIGGER ik_d1_stream_origin_page_insert AFTER INSERT ON ik_d1_stream_pages BEGIN INSERT INTO ik_d1_stream_origins(job_id,stream_id,ordinal,page_total,job_operation_key,parent_destination,parent_namespace,parent_mapping_version,parent_principal_id,parent_fingerprint,parent_operation_key,parent_total,parent_layout_hash) SELECT p.job_id,s.id,p.ordinal,p.total,j.operation_key,s.destination,s.namespace,s.mapping_version,s.principal_id,s.fingerprint,s.operation_key,s.total,s.layout_hash FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_origins o WHERE o.job_id=p.job_id) AND j.total IS p.total AND j.destination IS s.destination AND j.namespace IS s.namespace AND j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id AND p.job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_origin_page_update","sql":"CREATE TRIGGER ik_d1_stream_origin_page_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN INSERT INTO ik_d1_stream_origins(job_id,stream_id,ordinal,page_total,job_operation_key,parent_destination,parent_namespace,parent_mapping_version,parent_principal_id,parent_fingerprint,parent_operation_key,parent_total,parent_layout_hash) SELECT p.job_id,s.id,p.ordinal,p.total,j.operation_key,s.destination,s.namespace,s.mapping_version,s.principal_id,s.fingerprint,s.operation_key,s.total,s.layout_hash FROM ik_d1_stream_pages p JOIN ik_d1_streams s ON s.id=p.stream_id JOIN ik_jobs j ON j.id=p.job_id WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_origins o WHERE o.job_id=p.job_id) AND j.total IS p.total AND j.destination IS s.destination AND j.namespace IS s.namespace AND j.mapping_version IS s.mapping_version AND j.principal_id IS s.principal_id AND p.job_id=NEW.job_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_origin_parent","sql":"CREATE INDEX ik_d1_stream_origin_parent ON ik_d1_stream_origins(stream_id,ordinal)","table":"ik_d1_stream_origins","type":"index"},{"name":"ik_d1_stream_origin_update","sql":"CREATE TRIGGER ik_d1_stream_origin_update BEFORE UPDATE ON ik_d1_stream_origins BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_ORIGIN_CHANGED'); END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_page_delete","sql":"CREATE TRIGGER ik_d1_stream_page_delete AFTER DELETE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=OLD.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_page_insert","sql":"CREATE TRIGGER ik_d1_stream_page_insert AFTER INSERT ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_page_update","sql":"CREATE TRIGGER ik_d1_stream_page_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN UPDATE ik_d1_streams SET state='invalid' WHERE id=OLD.stream_id OR id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_delete BEFORE DELETE ON ik_d1_stream_revisions BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_delete AFTER DELETE ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_insert AFTER INSERT ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_origins_update","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_origins_update AFTER UPDATE ON ik_d1_stream_origins BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_origins","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_delete AFTER DELETE ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_insert AFTER INSERT ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_ik_d1_stream_pages_update","sql":"CREATE TRIGGER ik_d1_stream_revision_ik_d1_stream_pages_update AFTER UPDATE OF stream_id,ordinal,job_id,total ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_insert BEFORE INSERT ON ik_d1_stream_revisions WHEN EXISTS(SELECT 1 FROM ik_d1_stream_revisions WHERE stream_id=NEW.stream_id) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_d1_stream_revision_job_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_job_delete AFTER DELETE ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_job_insert AFTER INSERT ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_layout","sql":"CREATE TRIGGER ik_d1_stream_revision_job_layout AFTER UPDATE OF id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,reversal_policy,reversal_policy_hash ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id OR job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id OR job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_job_update","sql":"CREATE TRIGGER ik_d1_stream_revision_job_update AFTER UPDATE ON ik_jobs BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id IN (SELECT stream_id FROM ik_d1_stream_pages WHERE job_id=OLD.id OR job_id=NEW.id UNION SELECT stream_id FROM ik_d1_stream_origins WHERE job_id=OLD.id OR job_id=NEW.id); END","table":"ik_jobs","type":"trigger"},{"name":"ik_d1_stream_revision_page_erasure","sql":"CREATE TRIGGER ik_d1_stream_revision_page_erasure AFTER UPDATE OF erased_records ON ik_d1_stream_pages BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id=OLD.stream_id OR stream_id=NEW.stream_id; END","table":"ik_d1_stream_pages","type":"trigger"},{"name":"ik_d1_stream_revision_parent_delete","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_delete AFTER DELETE ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_insert","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_insert AFTER INSERT ON ik_d1_streams BEGIN INSERT INTO ik_d1_stream_revisions(stream_id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,layout_hash) SELECT NEW.id,NEW.destination,NEW.namespace,NEW.mapping_version,NEW.principal_id,NEW.fingerprint,NEW.operation_key,NEW.total,NEW.layout_hash WHERE NOT EXISTS(SELECT 1 FROM ik_d1_stream_revisions WHERE stream_id=NEW.id); UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_layout","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_layout AFTER UPDATE OF id,destination,namespace,mapping_version,principal_id,fingerprint,operation_key,total,layout_hash ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET layout_revision=layout_revision+1,progress_revision=progress_revision+1 WHERE stream_id=OLD.id OR stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_parent_update","sql":"CREATE TRIGGER ik_d1_stream_revision_parent_update AFTER UPDATE ON ik_d1_streams BEGIN UPDATE ik_d1_stream_revisions SET progress_revision=progress_revision+1 WHERE stream_id=OLD.id OR stream_id=NEW.id; END","table":"ik_d1_streams","type":"trigger"},{"name":"ik_d1_stream_revision_update","sql":"CREATE TRIGGER ik_d1_stream_revision_update BEFORE UPDATE ON ik_d1_stream_revisions WHEN NEW.stream_id IS NOT OLD.stream_id OR NEW.destination IS NOT OLD.destination OR NEW.mapping_version IS NOT OLD.mapping_version OR NEW.principal_id IS NOT OLD.principal_id OR NEW.fingerprint IS NOT OLD.fingerprint OR NEW.total IS NOT OLD.total OR NEW.layout_hash IS NOT OLD.layout_hash OR NEW.layout_revision<OLD.layout_revision OR NEW.progress_revision<=OLD.progress_revision OR ((NEW.namespace IS NOT OLD.namespace OR NEW.operation_key IS NOT OLD.operation_key) AND NOT (NEW.namespace='' AND NEW.operation_key='' AND NOT EXISTS(SELECT 1 FROM ik_d1_streams WHERE id=OLD.stream_id) AND EXISTS(SELECT 1 FROM ik_d1_retirements WHERE id=OLD.stream_id AND kind='stream'))) BEGIN SELECT RAISE(ABORT,'IMPORT_STREAM_REVISION_CHANGED'); END","table":"ik_d1_stream_revisions","type":"trigger"},{"name":"ik_provenance_job","sql":"CREATE INDEX ik_provenance_job ON ik_provenance(job_id,reversed,ordinal,effect_ordinal)","table":"ik_provenance","type":"index"},{"name":"ik_provenance_source","sql":"CREATE INDEX ik_provenance_source ON ik_provenance(source_identity,reversed)","table":"ik_provenance","type":"index"},{"name":"ik_sources_job","sql":"CREATE INDEX ik_sources_job ON ik_sources(job_id)","table":"ik_sources","type":"index"},{"name":"integration_deliveries_due","sql":"CREATE INDEX integration_deliveries_due ON integration_deliveries(namespace,state,next_at)","table":"integration_deliveries","type":"index"},{"name":"intelligence_strategy_problem","sql":"CREATE INDEX intelligence_strategy_problem ON intelligence_strategies(problem_id,state)","table":"intelligence_strategies","type":"index"},{"name":"knowledge_dependency_parent","sql":"CREATE INDEX knowledge_dependency_parent ON knowledge_dependencies(app_id,parent_id)","table":"knowledge_dependencies","type":"index"},{"name":"knowledge_fact_cutoff","sql":"CREATE INDEX knowledge_fact_cutoff ON knowledge_fact_revisions(app_id,known_at,effective_at)","table":"knowledge_fact_revisions","type":"index"},{"name":"launch_analysis_authority_terminal","sql":"CREATE TRIGGER launch_analysis_authority_terminal AFTER UPDATE OF state ON launch_analysis_requests WHEN NEW.state IN ('Complete','Failed','Unknown') BEGIN UPDATE launch_analysis_requests SET authority_json=NULL WHERE id=NEW.id; END","table":"launch_analysis_requests","type":"trigger"},{"name":"launch_authority_removed","sql":"CREATE TRIGGER launch_authority_removed AFTER UPDATE OF state ON authority_principals WHEN NEW.state<>'active' BEGIN UPDATE launch_analysis_requests SET state='Failed',error_code='forbidden',error_message='Requesting authority was removed' WHERE state IN ('Queued','Running') AND (actor_id=NEW.id OR json_extract(authority_json,'$.id')=NEW.id); UPDATE launch_analysis_requests SET authority_json=NULL WHERE actor_id=NEW.id OR json_extract(authority_json,'$.id')=NEW.id; UPDATE launch_automation_authorities SET principal_json=NULL WHERE json_extract(principal_json,'$.id')=NEW.id; END","table":"authority_principals","type":"trigger"},{"name":"launch_automation_shipped_key","sql":"CREATE UNIQUE INDEX launch_automation_shipped_key ON automations(shipped_key)","table":"automations","type":"index"},{"name":"launch_campaign_tag_projection","sql":"CREATE VIEW launch_campaign_tag_projection AS\nSELECT id,campaign_id AS record_id,tag AS value,ROW_NUMBER() OVER(PARTITION BY campaign_id ORDER BY tag,id)-1 AS position FROM campaign_tags","table":"launch_campaign_tag_projection","type":"view"},{"name":"launch_decision_campaign","sql":"CREATE INDEX launch_decision_campaign ON decisions(campaign_id,state,id)","table":"decisions","type":"index"},{"name":"launch_deliverable_due","sql":"CREATE INDEX launch_deliverable_due ON deliverables(due_date,state,campaign_id,id)","table":"deliverables","type":"index"},{"name":"launch_dependency_reverse","sql":"CREATE INDEX launch_dependency_reverse ON milestone_dependencies(predecessor_id,milestone_id)","table":"milestone_dependencies","type":"index"},{"name":"launch_milestone_campaign","sql":"CREATE INDEX launch_milestone_campaign ON milestones(campaign_id,start_date,id)","table":"milestones","type":"index"},{"name":"launch_model_calls_day","sql":"CREATE INDEX launch_model_calls_day ON launch_model_calls(local_day,feature)","table":"launch_model_calls","type":"index"},{"name":"launch_readiness_outstanding","sql":"CREATE UNIQUE INDEX launch_readiness_outstanding ON launch_readiness(milestone_id) WHERE state='Outstanding'","table":"launch_readiness","type":"index"},{"name":"launch_risk_campaign","sql":"CREATE INDEX launch_risk_campaign ON risks(campaign_id,state,severity,id)","table":"risks","type":"index"},{"name":"launch_run_trigger","sql":"CREATE UNIQUE INDEX launch_run_trigger ON automation_runs(automation_id,definition_version,trigger_key) WHERE retry_of IS NULL","table":"automation_runs","type":"index"},{"name":"launch_runs_state","sql":"CREATE INDEX launch_runs_state ON automation_runs(state,queued_at,id)","table":"automation_runs","type":"index"},{"name":"launch_search_campaigns_delete","sql":"CREATE TRIGGER launch_search_campaigns_delete AFTER DELETE ON campaigns BEGIN DELETE FROM launch_search WHERE rowid=(SELECT id FROM launch_search_rows WHERE record_id=old.id AND record_type='Campaign'); DELETE FROM launch_search_rows WHERE record_id=old.id AND record_type='Campaign'; END","table":"campaigns","type":"trigger"},{"name":"launch_search_campaigns_insert","sql":"CREATE TRIGGER launch_search_campaigns_insert AFTER INSERT ON campaigns BEGIN INSERT INTO launch_search_rows(record_id,record_type) VALUES(new.id,'Campaign'); INSERT INTO launch_search(rowid,record_id,campaign_id,record_type,body) VALUES((SELECT id FROM launch_search_rows WHERE record_id=new.id AND record_type='Campaign'),new.id,new.id,'Campaign',new.name||' '||new.code||' '||new.status_summary); END","table":"campaigns","type":"trigger"},{"name":"launch_search_campaigns_update","sql":"CREATE TRIGGER launch_search_campaigns_update AFTER UPDATE OF id,name,code,status_summary ON campaigns BEGIN DELETE FROM launch_search WHERE rowid=(SELECT id FROM launch_search_rows WHERE record_id=old.id AND record_type='Campaign'); UPDATE launch_search_rows SET record_id=new.id WHERE record_id=old.id AND record_type='Campaign'; INSERT INTO launch_search(rowid,record_id,campaign_id,record_type,body) VALUES((SELECT id FROM launch_search_rows WHERE record_id=new.id AND record_type='Campaign'),new.id,new.id,'Campaign',new.name||' '||new.code||' '||new.status_summary); END","table":"campaigns","type":"trigger"},{"name":"launch_search_decisions_delete","sql":"CREATE TRIGGER launch_search_decisions_delete AFTER DELETE ON decisions BEGIN DELETE FROM launch_search WHERE rowid=(SELECT id FROM launch_search_rows WHERE record_id=old.id AND record_type='Decision'); DELETE FROM launch_search_rows WHERE record_id=old.id AND record_type='Decision'; END","table":"decisions","type":"trigger"},{"name":"launch_search_decisions_insert","sql":"CREATE TRIGGER launch_search_decisions_insert AFTER INSERT ON decisions BEGIN INSERT INTO launch_search_rows(record_id,record_type) VALUES(new.id,'Decision'); INSERT INTO launch_search(rowid,record_id,campaign_id,record_type,body) VALUES((SELECT id FROM launch_search_rows WHERE record_id=new.id AND record_type='Decision'),new.id,new.campaign_id,'Decision',new.title); END","table":"decisions","type":"trigger"},{"name":"launch_search_decisions_update","sql":"CREATE TRIGGER launch_search_decisions_update AFTER UPDATE OF id,campaign_id,title ON decisions BEGIN DELETE FROM launch_search WHERE rowid=(SELECT id FROM launch_search_rows WHERE record_id=old.id AND record_type='Decision'); UPDATE launch_search_rows SET record_id=new.id WHERE record_id=old.id AND record_type='Decision'; INSERT INTO launch_search(rowid,record_id,campaign_id,record_type,body) VALUES((SELECT id FROM launch_search_rows WHERE record_id=new.id AND record_type='Decision'),new.id,new.campaign_id,'Decision',new.title); END","table":"decisions","type":"trigger"},{"name":"launch_search_deliverables_delete","sql":"CREATE TRIGGER launch_search_deliverables_delete AFTER DELETE ON deliverables BEGIN DELETE FROM launch_search WHERE rowid=(SELECT id FROM launch_search_rows WHERE record_id=old.id AND record_type='Deliverable'); DELETE FROM launch_search_rows WHERE record_id=old.id AND record_type='Deliverable'; END","table":"deliverables","type":"trigger"},{"name":"launch_search_deliverables_insert","sql":"CREATE TRIGGER launch_search_deliverables_insert AFTER INSERT ON deliverables BEGIN INSERT INTO launch_search_rows(record_id,record_type) VALUES(new.id,'Deliverable'); INSERT INTO launch_search(rowid,record_id,campaign_id,record_type,body) VALUES((SELECT id FROM launch_search_rows WHERE record_id=new.id AND record_type='Deliverable'),new.id,new.campaign_id,'Deliverable',new.title); END","table":"deliverables","type":"trigger"},{"name":"launch_search_deliverables_update","sql":"CREATE TRIGGER launch_search_deliverables_update AFTER UPDATE OF id,campaign_id,title ON deliverables BEGIN DELETE FROM launch_search WHERE rowid=(SELECT id FROM launch_search_rows WHERE record_id=old.id AND record_type='Deliverable'); UPDATE launch_search_rows SET record_id=new.id WHERE record_id=old.id AND record_type='Deliverable'; INSERT INTO launch_search(rowid,record_id,campaign_id,recor