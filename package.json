{
  "name": "cradle",
  "private": true,
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-cradle"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "check": "rer check",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "dev": "rer dev",
    "test:smoke": "node --test tests/http-smoke.mjs",
    "verify": "rer verify",
    "preview": "rer preview",
    "types": "wrangler types --include-runtime false",
    "test:start": "node --test --test-concurrency=1 tests/start-runtime.mjs tests/start-resources.mjs",
    "deploy": "rer deploy",
    "test:integration": "node --import ./tests/helpers/typescript-loader.mjs --test tests/runtime-configuration.mjs",
    "brand:icons": "node scripts/brand-icons.mjs",
    "source:inspect": "node scripts/edition-authoring/cli.mjs inspect",
    "source:check": "node scripts/edition-authoring/cli.mjs check",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "test:domains": "node --test --test-concurrency=1 tests/execution-d1.mjs tests/evidence-read-privacy.mjs tests/runtime-errors.mjs",
    "test:ui": "node tests/ui-cradle-browser.mjs",
    "test:migration": "node --test --test-concurrency=1 tests/migration-events.mjs tests/migration-history.mjs",
    "test:migration:browser": "node tests/migration-browser.mjs",
    "test:repairs": "node --test --test-concurrency=1 tests/repairs-case-runtime.mjs tests/repairs-controls-runtime.mjs tests/repairs-quotes-runtime.mjs tests/repairs-source-versions.mjs tests/repairs-faults-d1.mjs tests/business-decisions-d1.mjs tests/repairs-outcome-http.mjs",
    "test:repairs:browser": "node tests/ui-repairs-browser.mjs",
    "test:a11y": "node tests/accessibility-campaign.mjs",
    "test:records": "node --test --test-concurrency=1 tests/records-transport.mjs",
    "test:launch": "node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/launch-authority-browser.mjs tests/launch-installed-ai-failures.mjs tests/launch-installed-event-control.mjs tests/launch-installed-network-cancel.mjs tests/launch-installed-retries.mjs tests/launch-installed-runtime.mjs tests/launch-installed-schedules.mjs tests/launch-installed-ui.mjs tests/launch-operator-doors.mjs tests/launch-optional-fields.mjs tests/launch-production-composition.mjs tests/launch-scoped-authority.mjs tests/launch-search-authority.mjs tests/launch-setup-race.mjs tests/launch-write-authority.mjs tests/launch-write-effects.mjs tests/launch-write-service.mjs tests/launch-template-update.mjs",
    "test:launch:doors": "node tests/ui-launch-operator-doors.mjs",
    "test:foundation": "node --test --test-concurrency=1 tests/foundation-shell.mjs",
    "test:base": "node --test --test-concurrency=1 tests/base-installation.mjs tests/auth-base-only-runtime.mjs",
    "test:records:release": "node --import ./tests/helpers/typescript-loader.mjs --test tests/records-manual-release.mjs tests/records-manual-roundtrip.mjs tests/records-csv-fence.mjs tests/records-grid-range.mjs",
    "test:records:browser": "node --import ./tests/helpers/typescript-loader.mjs tests/ui-records-builder.mjs",
    "test:local": "node --test --test-concurrency=1 tests/installed-home.mjs tests/public-document-runtime.mjs tests/local-auth-runtime.mjs && node tests/ui-local-signin.mjs",
    "test:launch:walkthrough": "node tests/ui-launch-walkthrough.mjs",
    "test:recut:browser": "node --import ./tests/helpers/typescript-loader.mjs tests/ui-recut-final.mjs",
    "test:records:base-native": "node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/records-import-preview-auth.mjs tests/records-import-d1.mjs tests/records-import-fixtures-d1.mjs tests/records-import-content-native.mjs tests/records-import-undo-restart.mjs tests/records-import-undo-d1.mjs tests/records-import-migration.mjs",
    "test:records:base-browser": "node --import ./tests/helpers/typescript-loader.mjs tests/ui-base-import.mjs && node --import ./tests/helpers/typescript-loader.mjs tests/ui-base-undo.mjs",
    "test:records:base-exits": "node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/records-base-json-metadata-native.mjs tests/records-base-json-http.mjs tests/records-base-required.mjs tests/records-base-export-policy.mjs tests/records-base-metadata-conflicts.mjs tests/records-base-exits.mjs tests/records-base-edge-return.mjs tests/records-base-exit-restart.mjs tests/records-csv-correspondence-http.mjs",
    "test:records:base-exits-browser": "node --import ./tests/helpers/typescript-loader.mjs tests/ui-base-exits.mjs",
    "setup": "rer setup",
    "egress:relay": "node --experimental-strip-types scripts/egress-relay.ts",
    "test:user-automations": "node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/user-api-keys.mjs tests/user-automations.mjs tests/user-webhooks.mjs tests/records-import-effects.mjs tests/records-import-receipt.mjs tests/records-agent-proposals.mjs",
    "test:user-automations:browser": "node --import ./tests/helpers/typescript-loader.mjs tests/ui-user-automations.mjs",
    "delivery:artifact": "node scripts/build-delivery-artifact.mjs",
    "test:admission": "node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/signed-owner-admission.mjs",
    "test:admission:browser": "node --import ./tests/helpers/typescript-loader.mjs tests/ui-admission-editor.mjs",
    "build:app": "vite build && node scripts/build-migrations.mjs",
    "check:types": "tsc --noEmit",
    "verify:app": "node scripts/verify-app.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "deps": "rer install",
    "rer": "rer",
    "test:contract": "rer check --profile first-party",
    "test:execution-resolution": "node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/execution-resolution.mjs tests/execution-budget-readback.mjs",
    "test:execution-resolution:browser": "node --import ./tests/helpers/typescript-loader.mjs tests/ui-execution-resolution-browser.mjs",
    "test:lifecycle-erasure": "node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/lifecycle-erasure.mjs tests/lifecycle-identity-security.mjs",
    "test:repairs:outcome": "node tests/ui-repairs-outcome-browser.mjs",
    "test:oidc": "CRADLE_OIDC_EMITTED=1 node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/auth-oidc.mjs",
    "deployment:spec": "node scripts/sync-managed-setup.mjs",
    "check:deployment-spec": "node scripts/sync-managed-setup.mjs --check",
    "test:calendar": "node --import ./tests/helpers/typescript-loader.mjs --test --test-concurrency=1 tests/ui-records-calendar.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@xmldom/xmldom": "0.8.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "hyparquet-writer": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svix": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "xml-crypto": "6.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.80",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "highlight.js": "10.7.3",
    "hyparquet": "1.31.5",
    "miniflare": "5.20260907.0-alpha",
    "react-markdown": "6.0.3",
    "remark-gfm": "1.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  }
}
