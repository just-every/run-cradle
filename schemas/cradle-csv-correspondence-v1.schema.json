{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cradle.example/schemas/cradle-csv-correspondence-v1.schema.json",
  "title": "Cradle CSV correspondence version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "cradle-csv-correspondence"
    },
    "version": {
      "const": 1
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10485760
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "primaryColumnKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "date",
                    "boolean",
                    "select",
                    "url",
                    "relation",
                    "computed"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "unique": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "key",
                "type",
                "required",
                "unique"
              ]
            },
            "minItems": 1,
            "maxItems": 160
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "ordinal": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "primary": {
                  "type": "string",
                  "maxLength": 100000
                }
              },
              "required": [
                "id",
                "ordinal",
                "primary"
              ]
            },
            "minItems": 0,
            "maxItems": 10000
          }
        },
        "required": [
          "id",
          "filename",
          "bytes",
          "sha256",
          "primaryColumnKey",
          "columns",
          "rows"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "columnId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "referenceText": {
            "type": "string",
            "maxLength": 100000
          },
          "targetTableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "targetRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "tableId",
          "recordId",
          "columnId",
          "occurrence",
          "referenceText",
          "targetTableId",
          "targetRecordId"
        ]
      },
      "minItems": 0,
      "maxItems": 16000000
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "columnId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "state": {
            "enum": [
              "null",
              "empty",
              "false"
            ]
          }
        },
        "required": [
          "tableId",
          "recordId",
          "columnId",
          "state"
        ]
      },
      "minItems": 0,
      "maxItems": 16000000
    }
  },
  "required": [
    "format",
    "version",
    "tables",
    "references",
    "cells"
  ]
}
