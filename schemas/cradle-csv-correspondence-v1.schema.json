{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cradle.example/schemas/cradle-csv-correspondence-v1.schema.json",
  "title": "Cradle CSV correspondence version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "cradle-csv-correspondence"
    },
    "version": {
      "const": 1
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10485760
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "primaryColumnKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "type": {
                  "enum": [
                    "email",
                        "rating",
                        "duration",
                        "phone",
                    "text",
                    "number",
                    "date",
                    "boolean",
                    "select",
                    "url",
                    "relation",
                    "computed",
                    "instant",
                    "money",
                    "multi_select",
                    "person",
                    "attachment"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "unique": {
                  "type": "boolean"
                },
                "options": {
                  "maxItems": 10000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "id",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                "relation": {
                  "type": "object",
                  "properties": {
                    "tableId": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "cardinality": {
                      "type": "string",
                      "enum": [
                        "one",
                        "many"
                      ]
                    },
                    "onDelete": {
                      "type": "string",
                      "const": "restrict"
                    }
                  },
                  "required": [
                    "tableId",
                    "cardinality",
                    "onDelete"
                  ],
                  "additionalProperties": false
                },
                "validation": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "min": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "max": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "pattern": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "minLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    }
                  }
                },
                "numberFormat": {
                  "const": "percent"
                },
                "defaultValue": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "minor": {
                          "type": "string",
                          "maxLength": 129,
                          "pattern": "^-?(0|[1-9]\\d*)$"
                        },
                        "currency": {
                          "type": "string",
                          "pattern": "^[A-Z]{3}$"
                        },
                        "scale": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 6
                        }
                      },
                      "required": [
                        "minor",
                        "currency",
                        "scale"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "appId": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "entityId": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "recordId": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        }
                      },
                      "required": [
                        "appId",
                        "entityId",
                        "recordId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "maxItems": 10000,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "appId": {
                            "type": "string",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                          },
                          "entityId": {
                            "type": "string",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                          },
                          "recordId": {
                            "type": "string",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                          }
                        },
                        "required": [
                          "appId",
                          "entityId",
                          "recordId"
                        ],
                        "additionalProperties": false
                      }
                    },
                    {
                      "maxItems": 10000,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "maxItems": 10000,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "fileId": {
                            "type": "string",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                          }
                        },
                        "required": [
                          "fileId"
                        ],
                        "additionalProperties": false
                      }
                    }
                  ]
                },
                "notifyOnAdd": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "key",
                "type",
                "required",
                "unique"
              ]
            },
            "minItems": 1,
            "maxItems": 160
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "ordinal": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "primary": {
                  "type": "string",
                  "maxLength": 100000
                }
              },
              "required": [
                "id",
                "ordinal",
                "primary"
              ]
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "validationRules": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                },
                "when": {
                  "$ref": "#/$defs/ruleCondition"
                },
                "require": {
                  "$ref": "#/$defs/ruleCondition"
                }
              },
              "required": [
                "id",
                "name",
                "message",
                "when",
                "require"
              ]
            }
          }
        },
        "required": [
          "id",
          "filename",
          "bytes",
          "sha256",
          "primaryColumnKey",
          "columns",
          "rows"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "columnId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "referenceText": {
            "type": "string",
            "maxLength": 100000
          },
          "targetTableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "targetRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "tableId",
          "recordId",
          "columnId",
          "occurrence",
          "referenceText",
          "targetTableId",
          "targetRecordId"
        ]
      },
      "minItems": 0,
      "maxItems": 16000000
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "columnId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "state": {
            "enum": [
              "null",
              "empty",
              "false"
            ]
          }
        },
        "required": [
          "tableId",
          "recordId",
          "columnId",
          "state"
        ]
      },
      "minItems": 0,
      "maxItems": 16000000
    },
    "baseId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "required": [
    "format",
    "version",
    "tables",
    "references",
    "cells"
  ],
  "$defs": {
    "ruleCondition": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/ruleCondition"
              }
            }
          },
          "required": [
            "kind",
            "conditions"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "condition"
            },
            "fieldId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "empty",
                "not_empty"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "minor": {
                      "type": "string",
                      "maxLength": 129,
                      "pattern": "^-?(0|[1-9]\\d*)$"
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "scale": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    }
                  },
                  "required": [
                    "minor",
                    "currency",
                    "scale"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "appId": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "recordId": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    }
                  },
                  "required": [
                    "appId",
                    "entityId",
                    "recordId"
                  ],
                  "additionalProperties": false
                },
                {
                  "maxItems": 10000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "appId": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      "entityId": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      "recordId": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      }
                    },
                    "required": [
                      "appId",
                      "entityId",
                      "recordId"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "maxItems": 10000,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "maxItems": 10000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "fileId": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      }
                    },
                    "required": [
                      "fileId"
                    ],
                    "additionalProperties": false
                  }
                }
              ]
            }
          },
          "required": [
            "kind",
            "fieldId",
            "op"
          ]
        }
      ]
    }
  }
}
